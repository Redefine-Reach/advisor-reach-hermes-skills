#!/usr/bin/env python3
"""Fake Hermes 0.21.0 CLI for the live-replay tests. No model, no network except the eval SMS stub.

chat [--resume SID] (-q TEXT | --query-file F) [--source S]: stores the owner turn and a reply in
$HERMES_HOME/state.db and replies "ctx=<prior turns> fresh=<yes|no> last=<owner text tail>".
If the owner text contains TRY_SEND it POSTs to the stub from SMS_RUNTIME_ENV_FILE (like a send tool).
If it contains FAKE_NO_PERSIST it replies without storing anything (simulates a lost resume).
"""
import json, os, sqlite3, sys, urllib.request, uuid
from pathlib import Path

args = sys.argv[1:]
if "--version" in args:
    print("Hermes Agent v0.21.0"); sys.exit(0)
assert args and args[0] == "chat", args
home = Path(os.environ["HERMES_HOME"])
def opt(name):
    return args[args.index(name) + 1] if name in args else None
text = opt("-q") if "-q" in args else Path(opt("--query-file")).read_text(encoding="utf-8")
sid = opt("--resume")
marker = home / ".fake-hermes-touched"
fresh = "no" if marker.exists() else "yes"
marker.write_text("x")
con = sqlite3.connect(home / "state.db")
con.execute("create table if not exists sessions (id text primary key, source text)")
con.execute("create table if not exists messages (session_id text, role text, content text, tool_name text)")
if sid:
    if not con.execute("select 1 from sessions where id=?", (sid,)).fetchone():
        print(f"Session not found: {sid}", file=sys.stderr); sys.exit(1)
else:
    sid = "fake_" + uuid.uuid4().hex[:6]
    con.execute("insert into sessions values (?, ?)", (sid, opt("--source") or "cli"))
prior = con.execute("select count(*) from messages where session_id=? and role in ('user','assistant')", (sid,)).fetchone()[0]
if "TRY_SEND" in text:
    base = [l.split("=", 1)[1] for l in Path(os.environ["SMS_RUNTIME_ENV_FILE"]).read_text().splitlines()
            if l.startswith("TELNYX_SMS_API_BASE=")][0]
    urllib.request.urlopen(urllib.request.Request(base + "/v2/messages", data=b'{"to":"+15550100002","text":"x"}',
                                                  method="POST", headers={"Content-Type": "application/json"}), timeout=5).read()
reply = f"ctx={prior} fresh={fresh} last={text[-12:]}"
if "FAKE_NO_PERSIST" not in text:
    con.execute("insert into messages values (?, 'user', ?, null)", (sid, text))
    con.execute("insert into messages values (?, 'assistant', ?, null)", (sid, reply))
con.commit(); con.close()
print(reply)
print(f"session_id: {sid}")
